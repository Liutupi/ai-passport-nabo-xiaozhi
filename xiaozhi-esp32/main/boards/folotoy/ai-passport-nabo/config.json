{
  "manufacturer": "folotoy",
  "type": "ai-passport-nabo",
  "target": "esp32c3",
  "builds": [
    {
      "name": "ai-passport-nabo",
      "sdkconfig_append": [
        "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/ai_passport_nabo.csv\"",
        "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
        "CONFIG_USE_ESP_WAKE_WORD=n",
        "CONFIG_USE_DEFAULT_MESSAGE_STYLE=y",
        "CONFIG_USE_MULTILINE_CHAT_MESSAGE=n",
        "CONFIG_LV_CACHE_DEF_SIZE=0",
        "CONFIG_BT_ENABLED=y",
        "CONFIG_BT_NIMBLE_ENABLED=y",
        "CONFIG_BT_NIMBLE_NVS_PERSIST=y",
        "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
        "CONFIG_BT_NIMBLE_MAX_BONDS=4",
        "CONFIG_BT_NIMBLE_ROLE_CENTRAL=n",
        "CONFIG_BT_NIMBLE_ROLE_OBSERVER=n",
        "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
        "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
        "CONFIG_LV_FONT_MONTSERRAT_20=y",
        "CONFIG_LV_FONT_MONTSERRAT_28=y",
        "CONFIG_BT_NIMBLE_MEMPOOL_RUNTIME_ALLOC=y",
        "CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y",
        "CONFIG_MBEDTLS_ERROR_STRINGS=n",
        "CONFIG_ESP_ERR_TO_NAME_LOOKUP=n",
        "CONFIG_LV_USE_ARC=n",
        "CONFIG_LV_USE_ARCLABEL=n",
        "CONFIG_LV_USE_BUTTONMATRIX=n",
        "CONFIG_LV_USE_CHECKBOX=n",
        "CONFIG_LV_USE_DROPDOWN=n",
        "CONFIG_LV_USE_IMAGEBUTTON=n",
        "CONFIG_LV_USE_ROLLER=n",
        "CONFIG_LV_USE_SCALE=n",
        "CONFIG_LV_USE_SLIDER=n",
        "CONFIG_LV_USE_SWITCH=n",
        "CONFIG_LV_USE_TEXTAREA=n",
        "CONFIG_LV_USE_TABLE=n"
      ]
    }
  ]
}
